# ==================== REQUIRED ====================
# MongoDB Atlas connection string
# Get this from your MongoDB Atlas dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/uni_social_db?retryWrites=true&w=majority

# JWT Secret for authentication (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==================== OPTIONAL ====================
# API base URL (used by React client)
REACT_APP_API_BASE_URL=http://localhost:3001

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://susi-iocpt.ondigitalocean.app,https://lionfish-app-hgryb.ondigitalocean.app

# ==================== DEVELOPMENT ONLY ====================
# These are only used if you want to customize beyond defaults 
# PORT=3001
# NODE_ENV=production
