# Docker Environment Variables
# Copy this file to .env in the project root

# ==================== MONGODB ====================
# Root admin user (MongoDB creates this on first start)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=MySecureRootPass123!

# Application database user (used by your Node.js server)
MONGO_USERNAME=appuser
MONGO_PASSWORD=MySecureAppPass456!

# ==================== SERVER ====================
JWT_SECRET=your-64-character-minimum-secret-key-generate-with-crypto-randomBytes
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://yourdomain.com

# ==================== CLIENT ====================
REACT_APP_API_BASE_URL=http://localhost:3001

# ==================== HOW TO USE ====================
# 1. Copy this file: cp .env.docker.example .env
# 2. Change ALL passwords above to your own secure passwords
# 3. Generate JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 4. Run: docker-compose up --build
